# Generated by Accelerator Envoy `bootstrap-nginx` task.
# HTTP-only initial config. After running certbot, re-run bootstrap or
# use `bootstrap-ssl` to upgrade to the SSL stub automatically.
#
# To obtain SSL certificate:
#   sudo certbot certonly --webroot -w {{ root }}/current/public -d {{ domain }} -m {{ ssl_email }} --agree-tos
#   Then re-run: vendor/bin/envoy run bootstrap-ssl --stage={stage}

server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }};
    root {{ root }}/current/public;

    access_log /var/log/nginx/{{ domain }}.access.log;
    error_log /var/log/nginx/{{ domain }}.error.log;

    client_max_body_size 110m;
    server_tokens off;

{{ reverb_location }}

    # Certbot webroot challenge
    location /.well-known/acme-challenge/ {
        root {{ root }}/current/public;
    }

{{ application_locations }}
}
