; Generated by Accelerator Envoy `bootstrap-supervisor` task.
; Stage-scoped program names so that test/prod (or multiple projects) never collide.
;
; Variables interpolated by Envoy at write time:
;   {{ group }}          — Supervisor group name (e.g. wss_test)
;   {{ root }}           — deploy root (current symlink)
;   {{ run_user }}       — runtime user (e.g. www-data)
;   {{ php_bin }}        — PHP binary path
;   {{ octane_port }}    — Octane HTTP port
;   {{ runtime }}        — Octane server runtime (swoole | frankenphp)
;
; After editing manually:
;   sudo supervisorctl reread
;   sudo supervisorctl update

[program:{{ group }}_octane]
command={{ php_bin }} {{ root }}/current/artisan octane:start --server={{ runtime }} --host=127.0.0.1 --port={{ octane_port }} --workers=auto --task-workers=auto
directory={{ root }}/current
user={{ run_user }}
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
stdout_logfile={{ root }}/shared/storage/logs/octane.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
redirect_stderr=true

[program:{{ group }}_horizon]
command={{ php_bin }} {{ root }}/current/artisan horizon
directory={{ root }}/current
user={{ run_user }}
autostart=true
autorestart=true
stopwaitsecs=3600
stopasgroup=true
killasgroup=true
stdout_logfile={{ root }}/shared/storage/logs/horizon.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
redirect_stderr=true

[program:{{ group }}_reverb]
command={{ php_bin }} {{ root }}/current/artisan reverb:start
directory={{ root }}/current
user={{ run_user }}
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
stdout_logfile={{ root }}/shared/storage/logs/reverb.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
redirect_stderr=true

[program:{{ group }}_scheduler]
command={{ php_bin }} {{ root }}/current/artisan schedule:work
directory={{ root }}/current
user={{ run_user }}
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
stdout_logfile={{ root }}/shared/storage/logs/scheduler.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
redirect_stderr=true

[group:{{ group }}]
programs={{ group }}_octane,{{ group }}_horizon,{{ group }}_reverb,{{ group }}_scheduler
