#!/bin/bash
set -euo pipefail

# ─────────────────────────────────────────────────────────────────────
# LaraHelp — Laravel release-based deployment helper
# ─────────────────────────────────────────────────────────────────────
# Designed for Accelerator's release layout:
#   {root}/current -> releases/{id}
#   {root}/shared/.env
#   {root}/shared/storage
#   {root}/shared/database (SQLite)
#
# Must be run from within a release directory (has artisan file).
# ─────────────────────────────────────────────────────────────────────

VERSION="2.0.0"

# Resolve the PHP binary (respect OPS_DEPLOY_PHP_BIN or default)
PHP_BIN="${OPS_DEPLOY_PHP_BIN:-php}"

# Ensure we're in a Laravel root
if [ ! -f "artisan" ]; then
    echo "ERROR: not in a Laravel project root (no artisan file)." >&2
    exit 1
fi

CURRENT_USER=$(whoami)
RUN_USER="${OPS_DEPLOY_RUN_USER:-www-data}"

# Detect shared storage path (follow symlink)
STORAGE_PATH="storage"
if [ -L "$STORAGE_PATH" ]; then
    STORAGE_PATH=$(readlink -f "$STORAGE_PATH")
fi

# Detect shared database path
DB_PATH=""
if [ -f ".env" ]; then
    db_conn=$(grep -E "^DB_CONNECTION=" .env 2>/dev/null | cut -d= -f2 | tr -d '"' | tr -d "'" || true)
    if [ "$db_conn" = "sqlite" ]; then
        DB_PATH=$(grep -E "^DB_DATABASE=" .env 2>/dev/null | cut -d= -f2 | tr -d '"' | tr -d "'" || true)
    fi
fi

usage() {
    echo "LaraHelp v${VERSION} — Laravel release deploy helper"
    echo ""
    echo "Usage: larahelp <command>"
    echo ""
    echo "Commands:"
    echo "  --reoptimize          Clear all caches and re-optimize"
    echo "  --setfacl             Set ACL for storage & bootstrap/cache (+ SQLite if detected)"
    echo "  --log-size            Show storage/logs size"
    echo "  --log-truncate        Truncate laravel.log to last 1000 lines"
    echo "  --audit-permission    Scan for dangerous file permissions"
    echo "  --audit-public        Scan public/ for unauthorized PHP files"
    echo "  --version             Show version"
    exit 0
}

cmd_reoptimize() {
    echo "🚀 Re-optimizing Laravel..."
    $PHP_BIN artisan optimize:clear --ansi --quiet
    $PHP_BIN artisan optimize --ansi --quiet
    echo "✅ Re-optimize selesai!"
}

cmd_setfacl() {
    echo "🚀 Setting ACL..."

    # storage (may be symlink to shared)
    sudo setfacl -R -m "u:${RUN_USER}:rwx" -m "u:${CURRENT_USER}:rwx" "$STORAGE_PATH"
    sudo setfacl -dR -m "u:${RUN_USER}:rwx" -m "u:${CURRENT_USER}:rwx" "$STORAGE_PATH"

    # bootstrap/cache (release-local)
    if [ -d "bootstrap/cache" ]; then
        sudo setfacl -R -m "u:${RUN_USER}:rwx" -m "u:${CURRENT_USER}:rwx" bootstrap/cache
        sudo setfacl -dR -m "u:${RUN_USER}:rwx" -m "u:${CURRENT_USER}:rwx" bootstrap/cache
    fi

    # SQLite database file + directory
    if [ -n "$DB_PATH" ] && [ -f "$DB_PATH" ]; then
        local db_dir
        db_dir=$(dirname "$DB_PATH")
        sudo setfacl -R -m "u:${RUN_USER}:rwx" -m "u:${CURRENT_USER}:rwx" "$db_dir"
        sudo setfacl -dR -m "u:${RUN_USER}:rwx" -m "u:${CURRENT_USER}:rwx" "$db_dir"
        sudo setfacl -m "u:${RUN_USER}:rw" -m "u:${CURRENT_USER}:rw" "$DB_PATH"
        echo "  ✓ SQLite ACL applied: $DB_PATH"
    fi

    echo "✅ ACL berhasil diterapkan!"
}

cmd_log_size() {
    echo "📊 Storage logs size:"
    du -sh "$STORAGE_PATH/logs" 2>/dev/null || echo "  (no logs directory)"
}

cmd_log_truncate() {
    local logfile="$STORAGE_PATH/logs/laravel.log"
    if [ -f "$logfile" ]; then
        local lines
        lines=$(wc -l < "$logfile")
        if [ "$lines" -gt 1000 ]; then
            tail -1000 "$logfile" > "$logfile.tmp"
            mv "$logfile.tmp" "$logfile"
            echo "✅ Truncated laravel.log from $lines to 1000 lines."
        else
            echo "laravel.log is only $lines lines, no truncation needed."
        fi
    else
        echo "No laravel.log found."
    fi
}

cmd_audit_permission() {
    echo "🕵️  Auditing permissions..."

    # World-writable (excluding vendor, node_modules, .git)
    local red_flag
    red_flag=$(find . ! -type l -perm -002 \
        -not -path "*/vendor/*" \
        -not -path "*/node_modules/*" \
        -not -path "*/.git/*" 2>/dev/null || true)

    # Group-writable outside storage/cache
    local yellow_flag
    yellow_flag=$(find . ! -type l -perm -020 \
        -not -path "*/vendor/*" \
        -not -path "*/node_modules/*" \
        -not -path "*/.git/*" \
        -not -path "./storage*" \
        -not -path "./bootstrap/cache*" 2>/dev/null || true)

    if [ -z "$red_flag" ]; then
        echo "✅ No world-writable files found."
    else
        echo "🔴 CRITICAL — World-writable files:"
        echo "$red_flag"
    fi

    if [ -z "$yellow_flag" ]; then
        echo "✅ No group-writable files outside storage/cache."
    else
        echo "🟡 WARNING — Group-writable outside expected areas:"
        echo "$yellow_flag"
    fi
}

cmd_audit_public() {
    echo "🕵️  Scanning public/ for unauthorized PHP files..."
    local danger
    danger=$(find public -type f -name "*.php" ! -name "index.php" 2>/dev/null || true)

    if [ -z "$danger" ]; then
        echo "✅ Clean — only index.php found in public/."
    else
        echo "🚨 DANGER — Unauthorized PHP files in public/:"
        echo "$danger"
    fi
}

# ─────────────────────────────────────────────────────────────────────
# Main dispatch
# ─────────────────────────────────────────────────────────────────────

if [ $# -eq 0 ]; then
    usage
fi

case "$1" in
    --reoptimize)   cmd_reoptimize ;;
    --setfacl)      cmd_setfacl ;;
    --log-size)     cmd_log_size ;;
    --log-truncate) cmd_log_truncate ;;
    --audit-permission) cmd_audit_permission ;;
    --audit-public) cmd_audit_public ;;
    --version)      echo "LaraHelp v${VERSION}" ;;
    --help|-h)      usage ;;
    *)
        echo "Unknown command: $1" >&2
        usage
        ;;
esac
