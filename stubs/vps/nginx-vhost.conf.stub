# Generated by Accelerator Envoy `bootstrap-nginx` task.
# HTTP-only. Run certbot manually to add SSL:
#   sudo certbot --nginx -d {{ domain }} -m {{ ssl_email }} --agree-tos --redirect
#
# Variables interpolated by Envoy at write time:
#   {{ domain }}        — server_name
#   {{ root }}          — release root (current symlink)
#   {{ octane_port }}   — Laravel Octane internal port
#   {{ reverb_port }}   — Laravel Reverb websocket port (omit if not used)

upstream octane_{{ group }} {
    server 127.0.0.1:{{ octane_port }};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }};

    root {{ root }}/current/public;
    index index.php;

    access_log /var/log/nginx/{{ domain }}-access.log;
    error_log  /var/log/nginx/{{ domain }}-error.log;

    client_max_body_size 100m;
    server_tokens off;

    # Reverb websocket (optional — remove if Reverb is not enabled for this stage)
    location /app {
        proxy_pass http://127.0.0.1:{{ reverb_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Static assets — let nginx serve build/storage directly
    location /build/ {
        try_files $uri =404;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /storage/ {
        try_files $uri =404;
    }

    # Everything else proxies to Octane.
    # Important: do NOT add a `location ~ \.php$ { fastcgi_pass ... }` block —
    # that would shadow Livewire/Filament dynamic JS and route-backed assets.
    location / {
        proxy_pass http://octane_{{ group }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
