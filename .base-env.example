# App
APP_NAME=Accelerator
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=sqlite
# DB_SOCKET=
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# Session
SESSION_DRIVER=database
SESSION_STORE=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_COOKIE=
# Drivers
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
SCOUT_DRIVER=collection
MEILISEARCH_HOST=http://127.0.0.1:3013
# MEILISEARCH_KEY=
# Redis
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_PREFIX=
# CACHE_PREFIX=

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
VITE_APP_NAME="${APP_NAME}"
# VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Reverb
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# PDF
LARAVEL_PDF_DRIVER=gotenberg
GOTENBERG_URL=http://localhost:3011

# Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Telegram notifications
# TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URI=https://api.telegram.org

# Accelerator operator notifications
# ACCELERATOR_TELEGRAM_BOT_TOKEN=
# ACCELERATOR_TELEGRAM_CHAT_ID=
ACCELERATOR_TELEGRAM_NOTIFY_SUCCESSES=false

# Avatar
# ACCELERATOR_DICEBEAR_URL=
ACCELERATOR_DICEBEAR_VERSION=9.x
ACCELERATOR_DICEBEAR_STYLE=notionists

# Accelerator runtime features
ACCELERATOR_FEATURE_OAUTH=false
ACCELERATOR_FEATURE_PWA=false
ACCELERATOR_FEATURE_TELEGRAM=false
ACCELERATOR_FEATURE_REALTIME=false
ACCELERATOR_FEATURE_SCOUT=false
ACCELERATOR_FEATURE_OBSERVABILITY=false
ACCELERATOR_QUEUE_DRAIN_INTERVAL_SECONDS=10
ACCELERATOR_QUEUE_WORKER_TIMEOUT=120
ACCELERATOR_QUEUE_WORKER_MAX_TIME=50
ACCELERATOR_QUEUE_RETRY_AFTER_BUFFER_SECONDS=30
ACCELERATOR_OAUTH_MODE=disabled
ACCELERATOR_OAUTH_ALLOWED_DOMAINS=
ACCELERATOR_OAUTH_DEFAULT_ROLE=user
ACCELERATOR_UPLOAD_MAX_MB=100
ACCELERATOR_UI_DENSITY=compact
ACCELERATOR_ENVIRONMENT_INDICATOR_ENABLED=false
ACCELERATOR_ENVIRONMENT_INDICATOR_LABEL=
ACCELERATOR_ENVIRONMENT_INDICATOR_COLOR=warning
# Accelerator backup lifecycle (stage configuration derives deployment identity and time)
ACCELERATOR_BACKUP_ENABLED=true
ACCELERATOR_BACKUP_NAME=local
ACCELERATOR_BACKUP_DISKS=local
ACCELERATOR_BACKUP_TIME=02:00
ACCELERATOR_BACKUP_MAXIMUM_AGE_DAYS=2
ACCELERATOR_BACKUP_MAXIMUM_STORAGE_MEGABYTES=5000
ACCELERATOR_DEPLOYMENT_KEY=local
ACCELERATOR_DEPLOYMENT_STAGE=local
ACCELERATOR_DEPLOY_ROOT=
# BACKUP_ARCHIVE_PASSWORD=
# ACCELERATOR_SUPPORT_WHATSAPP=
# ACCELERATOR_SUPPORT_TELEGRAM=

# WebPush
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# OpenTelemetry / OpenObserve
OTEL_SERVICE_NAME=accelerator-local
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TIMEOUT=3000
OTEL_EXPORTER_OTLP_MAX_RETRIES=1
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_SAMPLER_TYPE=traceidratio
OTEL_TRACES_SAMPLER_TRACEIDRATIO_RATIO=1.0
OTEL_INSTRUMENTATION_HTTP_SERVER=false
OTEL_USER_CONTEXT=false
OTEL_RESOURCE_ATTRIBUTES="service.namespace=accelerator,deployment.environment.name=local,service.instance.id=accelerator-local"

# Development
# DEV_LOGIN=
# DEV_PASSWORD=
