{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "wireninja/accelerator",
    "description": "A batteries-included Laravel foundation for solo developers.",
    "type": "library",
    "autoload": {
        "psr-4": {
            "WireNinja\\Accelerator\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.22",
        "brick/math": "^0.17",
        "bezhansalleh/filament-shield": "^4.3",
        "blade-ui-kit/blade-icons": "^1.10",
        "mallardduck/blade-lucide-icons": "^1.26",
        "filament/filament": "^5.7",
        "http-interop/http-factory-guzzle": "^1.2",
        "jcupitt/vips": "^2.6",
        "laravel-lang/common": "^6.8",
        "laravel-notification-channels/webpush": "^11",
        "laravel/horizon": "^5.48",
        "laravel/octane": "^2.18",
        "laravel/pennant": "^1.24",
        "laravel/reverb": "^1.11",
        "laravel/scout": "^11.4",
        "laravel/socialite": "^5.29",
        "meilisearch/meilisearch-php": "^1.16",
        "spatie/image": "^3.9.5",
        "spatie/laravel-activitylog": "^5.0.0",
        "spatie/laravel-backup": "^10.2",
        "spatie/laravel-pdf": "^2.4",
        "spatie/laravel-query-builder": "^7.0",
        "stechstudio/filament-impersonate": "^5.6",
        "symfony/process": "^8.0",
        "laravel/nightwatch": "^1.28",
        "filament/spatie-laravel-settings-plugin": "^5.7",
        "filament/spatie-laravel-media-library-plugin": "^5.7",
        "laravel/mcp": "^0.9",
        "laravel-notification-channels/telegram": "^7.0",
        "laravel/prompts": "^0.3.21",
        "codewithdennis/filament-advanced-choice": "^2.1",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/fortify": "^1.37",
        "laravel/wayfinder": "^0.1.20",
        "phiki/phiki": "^2.2"
    },
    "extra": {
        "laravel": {
            "providers": [
                "WireNinja\\Accelerator\\AcceleratorServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
