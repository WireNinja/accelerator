# WireNinja Accelerator v2 deployment configuration.
# Local-only: every non-comment key in this file must begin with OPS_DEPLOY_.

# Project
OPS_DEPLOY_DEFAULT_STAGE={{ default_stage }}
OPS_DEPLOY_PROJECT={{ project }}
OPS_DEPLOY_SSH_HOST={{ ssh_host }}
OPS_DEPLOY_REPO={{ repo }}
OPS_DEPLOY_BRANCH={{ branch }}
OPS_DEPLOY_KEEP_RELEASES=5
OPS_DEPLOY_PHP_VERSION=8.5
OPS_DEPLOY_PHP_BIN=
OPS_DEPLOY_BUN_BIN=bun
OPS_DEPLOY_RUN_USER=www-data
OPS_DEPLOY_SSL_EMAIL={{ ssl_email }}

# Initial remote identity. The bcrypt hash avoids plaintext, but remains
# sensitive authentication material; this file must stay local and mode 0600.
OPS_DEPLOY_INITIAL_ADMIN_ENABLED=true
OPS_DEPLOY_INITIAL_ADMIN_NAME={{ admin_name }}
OPS_DEPLOY_INITIAL_ADMIN_USERNAME={{ admin_username }}
OPS_DEPLOY_INITIAL_ADMIN_EMAIL={{ admin_email }}
OPS_DEPLOY_INITIAL_ADMIN_PASSWORD_HASH={{ admin_password_hash }}

# Staging
OPS_DEPLOY_STAGING_ENABLED={{ staging_enabled }}
OPS_DEPLOY_STAGING_DOMAIN={{ staging_domain }}
OPS_DEPLOY_STAGING_ROOT={{ staging_root }}
OPS_DEPLOY_STAGING_GROUP={{ project }}_staging
OPS_DEPLOY_STAGING_DNS_DIRECT=true
OPS_DEPLOY_STAGING_HTTP_RUNTIME={{ http_runtime }}
OPS_DEPLOY_STAGING_FPM_POOL=
OPS_DEPLOY_STAGING_FPM_SOCKET=
OPS_DEPLOY_STAGING_FPM_SERVICE=
OPS_DEPLOY_STAGING_OCTANE_SERVER=swoole
OPS_DEPLOY_STAGING_OCTANE_PORT=9010
OPS_DEPLOY_STAGING_OCTANE_WORKERS=1
OPS_DEPLOY_STAGING_OCTANE_TASK_WORKERS=0
OPS_DEPLOY_STAGING_HORIZON_ENABLED={{ horizon_enabled }}
OPS_DEPLOY_STAGING_QUEUE_WORKER_ENABLED={{ queue_worker_enabled }}
OPS_DEPLOY_STAGING_QUEUE_WORKER_CONNECTION={{ queue_connection }}
OPS_DEPLOY_STAGING_QUEUE_WORKER_QUEUE=default
OPS_DEPLOY_STAGING_QUEUE_WORKER_PROCESSES=1
OPS_DEPLOY_STAGING_REVERB_ENABLED={{ reverb_enabled }}
OPS_DEPLOY_STAGING_REVERB_PORT=9011
OPS_DEPLOY_STAGING_SCHEDULER_ENABLED=true
OPS_DEPLOY_STAGING_NIGHTWATCH_ENABLED={{ nightwatch_enabled }}
OPS_DEPLOY_STAGING_NIGHTWATCH_PORT=2410

# Production
OPS_DEPLOY_PRODUCTION_ENABLED=true
OPS_DEPLOY_PRODUCTION_DOMAIN={{ production_domain }}
OPS_DEPLOY_PRODUCTION_ROOT={{ production_root }}
OPS_DEPLOY_PRODUCTION_GROUP={{ project }}_production
OPS_DEPLOY_PRODUCTION_DNS_DIRECT=true
OPS_DEPLOY_PRODUCTION_HTTP_RUNTIME={{ http_runtime }}
OPS_DEPLOY_PRODUCTION_FPM_POOL=
OPS_DEPLOY_PRODUCTION_FPM_SOCKET=
OPS_DEPLOY_PRODUCTION_FPM_SERVICE=
OPS_DEPLOY_PRODUCTION_OCTANE_SERVER=swoole
OPS_DEPLOY_PRODUCTION_OCTANE_PORT=9020
OPS_DEPLOY_PRODUCTION_OCTANE_WORKERS=1
OPS_DEPLOY_PRODUCTION_OCTANE_TASK_WORKERS=0
OPS_DEPLOY_PRODUCTION_HORIZON_ENABLED={{ horizon_enabled }}
OPS_DEPLOY_PRODUCTION_QUEUE_WORKER_ENABLED={{ queue_worker_enabled }}
OPS_DEPLOY_PRODUCTION_QUEUE_WORKER_CONNECTION={{ queue_connection }}
OPS_DEPLOY_PRODUCTION_QUEUE_WORKER_QUEUE=default
OPS_DEPLOY_PRODUCTION_QUEUE_WORKER_PROCESSES=1
OPS_DEPLOY_PRODUCTION_REVERB_ENABLED={{ reverb_enabled }}
OPS_DEPLOY_PRODUCTION_REVERB_PORT=9021
OPS_DEPLOY_PRODUCTION_SCHEDULER_ENABLED=true
OPS_DEPLOY_PRODUCTION_NIGHTWATCH_ENABLED={{ nightwatch_enabled }}
OPS_DEPLOY_PRODUCTION_NIGHTWATCH_PORT=2420
