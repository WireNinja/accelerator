<?php

declare(strict_types=1);

use Illuminate\Http\RedirectResponse;
use Illuminate\Support\Facades\Route;
use Inertia\Inertia;

{{ primary_route }}

Route::get('/inertia', static fn () => Inertia::render('Home'))
    ->middleware(['auth', 'verified', 'inertia'])
    ->name('inertia.home');

Route::livewire('/livewire', 'pages::home')
    ->middleware(['auth', 'verified'])
    ->name('livewire.home');
Route::get('/login', static fn (): RedirectResponse => redirect('/admin/login'))->name('login');
