{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write resources/ vite.config.js eslint.config.js",
        "format:check": "prettier --check resources/ vite.config.js eslint.config.js",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "tsc --noEmit"
    },
    "dependencies": {
        "laravel-echo": "^2.4.0",
        "laravel-vite-plugin": "^3.1.3",
        "leaflet": "^1.9.4",
        "pusher-js": "^8.6.0",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/leaflet": "^1.9.21",
        "@types/node": "^26.1.1",
        "@vite-pwa/assets-generator": "^1.0.2",
        "@wireninja/vite-plugin-laravel-pwa": "^0.1.3",
        "concurrently": "^10.0.4",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5",
        "vite-plugin-pwa": "^1.3.0"
    },
    "overrides": {
        "filelist": "2.0.2",
        "sharp": "0.35.3"
    },
    "packageManager": "{{ package_manager_spec }}"
}
