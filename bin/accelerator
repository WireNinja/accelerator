#!/usr/bin/env php
<?php

declare(strict_types=1);

use WireNinja\Accelerator\Installer\Installer;
use WireNinja\Accelerator\Installer\Onboarding;
use WireNinja\Accelerator\Installer\ProcessRunner;

$projectRoot = getcwd();
$packageRoot = dirname(__DIR__);
$autoload = $projectRoot.'/vendor/autoload.php';

if (! is_file($autoload)) {
    fwrite(STDERR, "Accelerator must run from a Composer-installed Laravel project root.\n");

    exit(1);
}

require $autoload;

if (in_array('--help', $argv, true)) {
    echo <<<'HELP'
WireNinja Accelerator v2 installer

Interactive:
  bash vendor/wireninja/accelerator/bin/install

Non-interactive:
  bash vendor/wireninja/accelerator/bin/install --no-interaction \
    --app-name="My Project" --app-url=http://my-project.test \
    --admin-name="Super Administrator" --admin-username=superadmin \
    --admin-email=admin@example.com --frontend=inertia --database=sqlite

Options:
  ACCELERATOR_ADMIN_PASSWORD="..." supplies the initial password without
  exposing it in shell history. Without it, a secure password is shown once.
  --features=filament,fortify,panels,settings,ticketing,pwa,insider,scout,wayfinder
  --redis
  --deploy --project=app --ssh-host=onidel --repo=git@example/app.git \
    --domain=app.example.com --deploy-root=/var/www/app.example.com \
    --http-runtime=octane
HELP;
    echo PHP_EOL;

    exit(0);
}

$journalPath = $projectRoot.'/.accelerator/install-state.json';
$environment = @file_get_contents($projectRoot.'/.env');

if (! is_file($journalPath) && is_string($environment) && str_contains($environment, 'ACCELERATOR_FEATURE_FILAMENT=')) {
    Laravel\Prompts\outro('Accelerator v2 is already installed. Run php artisan accelerator:doctor to verify it.');

    exit(0);
}

try {
    $processRunner = new ProcessRunner;
    $plan = (new Onboarding($projectRoot, $processRunner))->plan(array_slice($argv, 1));

    (new Installer(
        projectRoot: $projectRoot,
        packageRoot: $packageRoot,
        plan: $plan,
        processRunner: $processRunner,
    ))->run();
} catch (Throwable $exception) {
    Laravel\Prompts\error($exception->getMessage());
    Laravel\Prompts\note('Fix the reported cause, then run the same command again to resume.');

    exit(1);
}
